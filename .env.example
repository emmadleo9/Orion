# Orion server
PORT=3000
HOST=0.0.0.0

# Provider selection: token (default), direct-oauth, or connector.
# Set ORION_INSTAGRAM_PROVIDER=connector only when a trusted Manus bridge is available.
ORION_INSTAGRAM_PROVIDER=token
ORION_CONNECTOR_BRIDGE_URL=
ORION_CONNECTOR_BRIDGE_SECRET=

# Direct Meta OAuth (server-side only; never expose the secret to the browser).
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Override these only for local mock testing; keep Meta defaults in production.
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_OAUTH_GRAPH_URL=https://graph.instagram.com

# Meta / Instagram Graph API
# Use a Professional Instagram account connected to a Facebook Page.
INSTAGRAM_ACCESS_TOKEN=replace-with-a-long-lived-user-access-token
INSTAGRAM_USER_ID=replace-with-instagram-professional-account-id
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.facebook.com

# Optional request behavior
INSTAGRAM_REQUEST_TIMEOUT_MS=15000
INSTAGRAM_PUBLISH_POLL_INTERVAL_MS=2500
INSTAGRAM_PUBLISH_POLL_TIMEOUT_MS=120000
